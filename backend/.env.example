# Backend environment variables. Copy to `.env` for local dev, OR set these
# in the Render dashboard for production. Do NOT commit `.env` (already in .gitignore).

# === Database ===
# Local dev: mongodb://localhost:27017
# Production: MongoDB Atlas connection string, e.g.
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
# Database name stays "nearscene" — that's the actual Atlas database where
# all current production data lives. Brand is LocalDrift but the DB name is
# internal-only and not worth migrating.
DB_NAME=nearscene

# === CORS ===
# Comma-separated list of allowed origins, OR "*" for any (dev only).
# Production example: https://localdrift.app,https://www.localdrift.app
CORS_ORIGINS=*

# === Auth ===
# Generate a strong random string for production. `openssl rand -hex 32` works.
JWT_SECRET=change_me_to_a_long_random_string

# === Stripe ===
# Test mode keys start with sk_test_ / pk_test_. Live keys start with sk_live_.
STRIPE_API_KEY=sk_test_replace_me
# Webhook signing secret from Stripe dashboard (whsec_...). Optional in dev.
STRIPE_WEBHOOK_SECRET=

# === Payments ===
# Platform commission (0.05 = 5%) deducted from each ticket purchase.
COMMISSION_RATE=0.05

# === URLs ===
# Used as fallback origin when the request doesn't include one (e.g. webhooks).
# In production, set this to your deployed frontend URL.
PUBLIC_FRONTEND_URL=http://localhost:3000

# === Email (SMTP) ===
# Used for password resets, weekly digest, and admin notifications.
# Gmail SMTP works fine for low volume — generate an "App Password" at
# https://myaccount.google.com/apppasswords (requires 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=LocalDrift <hello@localdrift.app>

# Recipient for admin-only notifications (new community-source submissions,
# new reports, new feedback). Usually your own inbox. Leave blank to
# disable admin email alerts entirely.
ADMIN_NOTIFY_EMAIL=

# === Admin ===
# Shared secret for admin endpoints (/api/admin/*). Generated at deploy.
# Used in URL queries (?token=...) for admin dashboard pages and in
# X-Admin-Token header for programmatic calls. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=
